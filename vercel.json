{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/sweep",
      "schedule": "*/2 * * * *"
    }
  ],
  "functions": {
    "src/app/api/jobs/run/route.ts": { "maxDuration": 300 },
    "src/app/api/cron/sweep/route.ts": { "maxDuration": 300 },
    "src/app/api/webhooks/deepgram/route.ts": { "maxDuration": 300 },
    "src/app/api/meetings/[id]/finalize/route.ts": { "maxDuration": 300 },
    "src/app/api/meetings/[id]/regenerate/route.ts": { "maxDuration": 300 },
    "src/app/api/meetings/[id]/askfred/route.ts": { "maxDuration": 300 },
    "src/app/api/askfred/route.ts": { "maxDuration": 300 },
    "src/app/api/uploads/direct/route.ts": { "maxDuration": 300 }
  }
}
