# ---- Required ----
# Local:  postgresql://fireflies:fireflies@localhost:5433/fireflies
# Neon:   postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# openssl rand -base64 32
AUTH_SECRET=

# ---- Optional: everything below degrades gracefully ----
# Without these the app runs in DEMO_MODE (scripted transcripts + fixture summaries).

# https://console.deepgram.com  ($200 free credit) - real speech-to-text
DEEPGRAM_API_KEY=

# ---- Language model: pick ONE of the two blocks below ----
# Powers summaries, action items, sentence labelling and AskFred.
# With neither set, the app falls back to a keyword-based summarizer that still
# fills every screen - useful, but visibly not a real model.

# Option A - Anthropic (best quality; this is what the app is tuned for)
# https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Option B - any OpenAI-compatible endpoint, including free tiers.
# Used only when ANTHROPIC_API_KEY is empty. Examples:
#
#   Groq (free tier, no card)            https://console.groq.com/keys
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=llama-3.3-70b-versatile
#
#   Google Gemini (free tier, no card)   https://aistudio.google.com/apikey
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_MODEL=gemini-2.5-flash
#
#   Ollama (fully local, no key)         https://ollama.com
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_MODEL=llama3.1:8b
#     LLM_API_KEY=ollama
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Vercel dashboard > Storage > Blob - audio storage (falls back to data URLs locally)
BLOB_READ_WRITE_TOKEN=

# https://console.cloud.google.com/apis/credentials - Google sign-in
# Redirect URI: {PUBLIC_BASE_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public origin. Must be a real https URL for Deepgram/Blob webhooks to reach you.
# Leave as localhost for dev - the app switches to synchronous transcription automatically.
PUBLIC_BASE_URL=http://localhost:3000

# Shared secret guarding /api/jobs/run and /api/cron/sweep
INTERNAL_JOB_SECRET=

# Force scripted mode even when keys are present
DEMO_MODE=
