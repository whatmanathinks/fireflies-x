# ---- Required ----
# Local:  postgresql://fireflies:fireflies@localhost:5433/fireflies
# Neon:   postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# openssl rand -base64 32
AUTH_SECRET=

# ---- Optional: everything below degrades gracefully ----
# Without these the app runs in DEMO_MODE (scripted transcripts + fixture summaries).

# https://console.deepgram.com  ($200 free credit) - real speech-to-text
DEEPGRAM_API_KEY=

# ---- Language model: pick ONE of the two blocks below ----
# Powers summaries, action items, sentence labelling and AskFred.
# With neither set, the app falls back to a keyword-based summarizer that still
# fills every screen - useful, but visibly not a real model.

# Option A - Anthropic (best quality; this is what the app is tuned for)
# https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Option B - a pool of OpenAI-compatible endpoints, rotated automatically.
# Used only when ANTHROPIC_API_KEY is empty. Each entry has its own quota, so
# several free keys combine into a usable budget.
#   tier 0  tried first, and load-balanced - consecutive calls start on a
#           different entry, spreading load instead of draining one key
#   tier 1+ fallbacks, tried only once every tier-0 option is rate limited
#           or out of daily quota
#
# LLM_POOL='[
#   {"name":"groq-a","tier":0,"baseUrl":"https://api.groq.com/openai/v1",
#    "apiKey":"gsk_...","models":["openai/gpt-oss-120b","openai/gpt-oss-20b"]},
#   {"name":"gemini","tier":1,"baseUrl":"https://generativelanguage.googleapis.com/v1beta/openai",
#    "apiKey":"...","models":["gemini-2.5-flash-lite","gemini-3.1-flash-lite"]}
# ]'
LLM_POOL=

# Single-endpoint shorthand, used when LLM_POOL is empty.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Output token budget per request. Free tiers count this against their
# tokens-per-minute limit, so keep it modest (Groq free tier is 8000 TPM total).
LLM_MAX_TOKENS=3500
# Reasoning models (gpt-oss, qwen3, deepseek-r1) spend output tokens thinking before
# they answer, which can exhaust a small budget before any JSON is produced.
# "low" keeps them terse; "off" omits the parameter entirely.
LLM_REASONING_EFFORT=low
# Tokens-per-minute ceiling for your tier. Long meetings are split into chunks
# that fit inside it and merged back (map-reduce), so a 55-minute call works on
# a free tier. Groq free = 8000. Raise it on a paid tier for fewer, larger calls.
LLM_TPM_BUDGET=8000
# Rate limits are per-model on Groq, so an exhausted model is worked around by
# switching rather than waiting. Each name here gets its own budget.
LLM_FALLBACK_MODELS=openai/gpt-oss-20b

# Vercel dashboard > Storage > Blob - audio storage (falls back to data URLs locally)
BLOB_READ_WRITE_TOKEN=

# https://console.cloud.google.com/apis/credentials - Google sign-in
# Redirect URI: {PUBLIC_BASE_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public origin. Must be a real https URL for Deepgram/Blob webhooks to reach you.
# Leave as localhost for dev - the app switches to synchronous transcription automatically.
PUBLIC_BASE_URL=http://localhost:3000

# Shared secret guarding /api/jobs/run and /api/cron/sweep
INTERNAL_JOB_SECRET=

# https://recall.ai - sends a REAL notetaker bot into Zoom / Meet / Teams calls.
# Without it, "Add to live meeting" runs the simulated bot instead.
# First 5 hours are free; find your region's base URL in the Recall dashboard.
RECALL_API_KEY=
RECALL_REGION=us-west-2

# Force scripted mode even when keys are present
DEMO_MODE=
